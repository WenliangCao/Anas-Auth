    "Enter the password to decrypt the andOTP backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入密码以解密 andOTP 备份"
          }
        }
      }
    },
    "Export an encrypted backup from OTP Auth, then select the .otpauthdb or .otpauthdp file. Single-account .otpauth files are also supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 OTP Auth 导出加密备份，然后选择 .otpauthdb 或 .otpauthdp 文件。也支持单账户的 .otpauth 文件。"
          }
        }
      }
    },
    "Export Backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出备份"
          }
        }
      }
    },
    "Export Backup (%lld)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
