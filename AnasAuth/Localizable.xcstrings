        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏密钥"
          }
        }
      }
    },
    "If you lose the password, the backup can’t be restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码丢失后无法恢复备份。"
