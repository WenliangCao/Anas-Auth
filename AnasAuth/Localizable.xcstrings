    "Allow Anas Auth to use the camera in Settings, then come back and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请到系统设置中允许 Anas Auth 使用相机，然后返回重试。"
